generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  passwordHash        String
  firstName           String
  lastName            String
  middleName          String?
  image               String?
  affiliation         String?
  department          String?
  orcid               String?             @unique
  phone               String?
  country             String?
  bio                 String?
  role                Role                @default(AUTHOR)
  status              UserStatus          @default(PENDING_VERIFICATION)
  emailVerified       DateTime?
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  articleAuthors      ArticleAuthor[]     @relation("ArticleAuthorUser")
  decisions           EditorialDecision[]
  editorialNotes      EditorialNote[]
  editorialRoles      EditorialRole[]
  emailVerifications  EmailVerification[]
  assignedManuscripts Manuscript[]        @relation("ManuscriptEditor")
  manuscripts         Manuscript[]        @relation("ManuscriptAuthor")
  coAuthored          ManuscriptAuthor[]  @relation("CoAuthored")
  submittedVersions   ManuscriptVersion[] @relation("ManuscriptVersionSubmittedBy")
  notifications       Notification[]
  passwordResets      PasswordReset[]
  assignedReviews     Review[]            @relation("ReviewAssignedReviewer")
  reviewInvitations   ReviewInvitation[]  @relation("ReviewInvitationReviewer")
  sentInvitations     ReviewInvitation[]  @relation("ReviewInvitationInvitedBy")
  sessions            Session[]
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  content         String   @default("")
  sections        String?  @default("{}")
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Journal {
  id                String          @id @default(cuid())
  name              String
  shortName         String          @unique
  issnPrint         String?         @unique
  issnOnline        String?         @unique
  doiPrefix         String?
  description       String?
  scope             String?
  aims              String?
  scopeAreas        String          @default("[]")
  website           String?
  email             String
  logo              String?
  coverImage        String?
  heroBadge         String          @default("Now Accepting Submissions")
  heroTitle         String          @default("")
  heroSubtitle      String          @default("")
  heroISSN          String          @default("")
  heroImpactFactor  String          @default("")
  homepageStats     String          @default("[]")
  homepageFeatures  String          @default("[]")
  homepageIndexers  String          @default("[]")
  homepageCtaHeading String         @default("Submit Your Manuscript Today")
  homepageCtaText   String          @default("")
  heroCarousel      String          @default("[]")
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  announcements     Announcement[]
  editorialRoles    EditorialRole[]
  settings          JournalSetting?
  manuscripts       Manuscript[]
  volumes           Volume[]
}

model JournalSetting {
  id                      String   @id @default(cuid())
  journalId               String   @unique
  submissionOpen          Boolean  @default(true)
  allowMultipleSubmission Boolean  @default(false)
  requireCoverLetter      Boolean  @default(true)
  requireEthicsApproval   Boolean  @default(true)
  requireFundingStmt      Boolean  @default(true)
  requireDataAvailability Boolean  @default(true)
  maxAuthors              Int      @default(10)
  maxFileSizeMB           Int      @default(50)
  allowedFileTypes        String   @default("")
  reviewType              String   @default("DOUBLE_BLIND")
  reviewDeadlineDays      Int      @default(21)
  maxReviewers            Int      @default(3)
  minReviewers            Int      @default(2)
  autoAssignReviewers     Boolean  @default(false)
  enableORCID             Boolean  @default(true)
  enableORCIDAutoFill     Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  journal                 Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

model Volume {
  id          String    @id @default(cuid())
  journalId   String
  number      Int
  year        Int
  title       String?
  description String?
  coverImage  String?
  doi         String?
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
  journal     Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, number])
  @@index([journalId])
}

model Article {
  id                     String                  @id @default(cuid())
  volumeId               String
  manuscriptId           String?                 @unique
  slug                   String                  @unique
  title                  String
  shortTitle             String?
  abstract               String
  keywords               String                  @default("")
  doi                    String                  @unique
  doiRegistered          Boolean                 @default(false)
  pageStart              Int?
  pageEnd                Int?
  articleNumber          String?
  articleType            String
  section                String?
  language               String                  @default("en")
  license                String                  @default("CC BY 4.0")
  copyrightYear          Int?
  copyrightHolder        String?
  publishedPdfUrl        String?
  publishedAt            DateTime?
  isPublished            Boolean                 @default(false)
  isOpenAccess           Boolean                 @default(true)
  views                  Int                     @default(0)
  downloads              Int                     @default(0)
  citations              Int                     @default(0)
  altmetricScore         Float                   @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  volume                 Volume                  @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  manuscript             Manuscript?             @relation(fields: [manuscriptId], references: [id])
  authors                ArticleAuthor[]
  metrics                ArticleMetric?
  references             ArticleReference[]
  citationsRef           Citation[]
  supplementaryMaterials SupplementaryMaterial[]
}

model ArticleAuthor {
  id              String   @id @default(cuid())
  articleId       String
  userId          String?
  firstName       String
  lastName        String
  middleName      String?
  email           String?
  affiliation     String
  orcid           String?
  position        Int      @default(0)
  isCorresponding Boolean  @default(false)
  createdAt       DateTime @default(now())
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user            User?    @relation("ArticleAuthorUser", fields: [userId], references: [id])

  @@index([articleId])
  @@index([userId])
}

model ArticleReference {
  id        String   @id @default(cuid())
  articleId String
  title     String
  authors   String
  journal   String?
  year      Int?
  volume    String?
  issue     String?
  pages     String?
  doi       String?
  pmid      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model SupplementaryMaterial {
  id        String   @id @default(cuid())
  articleId String
  title     String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  type      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model Citation {
  id           String   @id @default(cuid())
  articleId    String
  citedArticle String
  citedDoi     String?
  citedAt      DateTime @default(now())
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleMetric {
  id        String   @id @default(cuid())
  articleId String   @unique
  views     Int      @default(0)
  downloads Int      @default(0)
  citations Int      @default(0)
  shares    Int      @default(0)
  mentions  Int      @default(0)
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Manuscript {
  id                    String              @id @default(cuid())
  journalId             String
  title                 String
  shortTitle            String?
  abstract              String
  keywords              String              @default("[]")
  articleType           String
  section               String?
  coverLetter           String?
  status                ManuscriptStatus    @default(SUBMITTED)
  submittedAt           DateTime            @default(now())
  assignedEditorId      String?
  correspondingAuthorId String
  currentVersion        Int                 @default(1)
  doi                   String?             @unique
  submittedVersion      String?
  acceptedVersion       String?
  publishedVersion      String?
  withdrawalReason      String?
  withdrawnAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  article               Article?
  decisions             EditorialDecision[]
  editorialNotes        EditorialNote[]
  journal               Journal             @relation(fields: [journalId], references: [id], onDelete: Cascade)
  assignedEditor        User?               @relation("ManuscriptEditor", fields: [assignedEditorId], references: [id])
  correspondingAuthor   User                @relation("ManuscriptAuthor", fields: [correspondingAuthorId], references: [id])
  authors               ManuscriptAuthor[]
  files                 ManuscriptFile[]
  versions              ManuscriptVersion[]
  reviews               Review[]
  reviewInvitations     ReviewInvitation[]

  @@index([journalId])
  @@index([correspondingAuthorId])
  @@index([assignedEditorId])
  @@index([status])
}

model ManuscriptAuthor {
  id              String     @id @default(cuid())
  manuscriptId    String
  userId          String?
  firstName       String
  lastName        String
  middleName      String?
  email           String
  affiliation     String
  orcid           String?
  position        Int        @default(0)
  isCorresponding Boolean    @default(false)
  contribution    String?
  createdAt       DateTime   @default(now())
  manuscript      Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  user            User?      @relation("CoAuthored", fields: [userId], references: [id])

  @@index([manuscriptId])
  @@index([userId])
}

model ManuscriptFile {
  id           String     @id @default(cuid())
  manuscriptId String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  fileType     String
  version      Int        @default(1)
  isPrimary    Boolean    @default(false)
  description  String?
  uploadedAt   DateTime   @default(now())
  manuscript   Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)

  @@index([manuscriptId])
}

model ManuscriptVersion {
  id            String     @id @default(cuid())
  manuscriptId  String
  version       Int
  title         String
  abstract      String
  keywords      String     @default("[]")
  fileUrl       String
  fileName      String
  fileSize      Int
  submittedById String
  submittedAt   DateTime   @default(now())
  changeNotes   String?
  manuscript    Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  submittedBy   User       @relation("ManuscriptVersionSubmittedBy", fields: [submittedById], references: [id])

  @@index([manuscriptId])
}

model Review {
  id                String            @id @default(cuid())
  manuscriptId      String
  reviewerId        String
  invitationId      String?
  round             Int               @default(1)
  status            String            @default("PENDING")
  decision          ReviewDecision?
  originality       Int?
  methodology       Int?
  significance      Int?
  clarity           Int?
  commentsToEditor  String?
  commentsToAuthor  String?
  confidentialNotes String?
  submittedAt       DateTime?
  dueDate           DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  manuscript        Manuscript        @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  reviewer          User              @relation("ReviewAssignedReviewer", fields: [reviewerId], references: [id])
  invitation        ReviewInvitation? @relation("ReviewInvitationReviews", fields: [invitationId], references: [id])

  @@index([manuscriptId])
  @@index([reviewerId])
  @@index([invitationId])
}

model ReviewInvitation {
  id           String     @id @default(cuid())
  manuscriptId String
  reviewerId   String
  invitedById  String
  round        Int        @default(1)
  status       String     @default("PENDING")
  message      String?
  response     String?
  respondedAt  DateTime?
  dueDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviews      Review[]   @relation("ReviewInvitationReviews")
  manuscript   Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  reviewer     User       @relation("ReviewInvitationReviewer", fields: [reviewerId], references: [id])
  invitedBy    User       @relation("ReviewInvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([manuscriptId])
  @@index([reviewerId])
  @@index([status])
}

model EditorialNote {
  id           String     @id @default(cuid())
  manuscriptId String
  authorId     String
  note         String
  isPrivate    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  manuscript   Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id])

  @@index([manuscriptId])
}

model EditorialDecision {
  id            String         @id @default(cuid())
  manuscriptId  String
  editorId      String
  decision      ReviewDecision
  notes         String?
  notesToAuthor String?
  createdAt     DateTime       @default(now())
  manuscript    Manuscript     @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  editor        User           @relation(fields: [editorId], references: [id])

  @@index([manuscriptId])
}

model EditorialRole {
  id        String    @id @default(cuid())
  userId    String
  journalId String
  role      Role
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal   Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([userId, journalId, role])
  @@index([journalId])
  @@index([userId])
}

model Announcement {
  id          String    @id @default(cuid())
  journalId   String
  title       String
  content     String
  type        String    @default("ANNOUNCEMENT")
  isPublished Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  journal     Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

enum Role {
  AUTHOR
  REVIEWER
  EDITOR
  ADMIN
  EDITOR_IN_CHIEF
  DEPUTY_EDITOR_IN_CHIEF
  ASSOCIATE_EDITOR
  INTERNATIONAL_EDITOR
}

enum ManuscriptStatus {
  SUBMITTED
  UNDER_REVIEW
  UNDER_REVISION
  ACCEPTED
  REJECTED
  PUBLISHED
  WITHDRAWN
}

enum ReviewDecision {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}
