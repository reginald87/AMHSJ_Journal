# Database (PostgreSQL recommended, SQLite for local dev)
DATABASE_URL="postgresql://amhsj:amhsj_dev_password@localhost:5432/amhsj"
# DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_SECRET="generate-a-strong-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin account (used by prisma/create-admin.ts)
ADMIN_EMAIL="admin@amhsj.org"
ADMIN_PASSWORD="change-this-to-a-strong-password"

# Email (SMTP)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@example.com"
EMAIL_SERVER_PASSWORD="your-password"
EMAIL_FROM="noreply@amhsj.org"

# OAuth (optional - leave blank to disable)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# ORCID_CLIENT_ID=""
# ORCID_CLIENT_SECRET=""
